{
  "description": "cc-hush: privacy proxy, secret block, shell/SQL guard",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-daemon.ts\"", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:47831/hook", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:47831/hook", "timeout": 30 }
        ]
      }
    ]
  }
}
